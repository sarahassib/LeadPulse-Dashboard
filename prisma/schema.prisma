generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id              String   @id @default(uuid())
  campaignId      String   @unique
  name            String
  platform        String
  status          String   @default("DRAFT")
  startDate       DateTime
  endDate         DateTime?
  angle           String
  cible           String?
  objectif        String?
  region          String?
  countries       String?
  message         String
  headline        String?
  description     String?
  visualType      String?
  callToAction    String?
  destinationType String?
  destinationUrl  String?
  objective       String?
  targetAudience  String?
  leads           Int      @default(0)
  mql             Int      @default(0)
  sql             Int      @default(0)
  nq              Int      @default(0)
  spend           Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  visuals         CampaignVisual[]
  metricEntries   CampaignMetricEntry[]
}

model CampaignVisual {
  id          String   @id @default(uuid())
  campaignId  String
  imageUrl    String
  fileName    String
  altText     String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignMetricEntry {
  id          String   @id @default(uuid())
  campaignId  String
  date        DateTime
  leads       Int      @default(0)
  mql         Int      @default(0)
  sql         Int      @default(0)
  nq          Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model Setting {
  id        String   @id @default(uuid())
  category  String
  value     String
  createdAt DateTime @default(now())

  @@unique([category, value])
}
